{
	"name": "tg-pricewatch-bot",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "wrangler dev",
		"deploy": "wrangler deploy",
		"test": "vitest run",
		"lint":"biome check .",
		"lint:fix":"bun biome check --write .",
		"db:local": "wrangler d1 execute pricewatch --local --file",
		"db:remote": "wrangler d1 execute pricewatch --remote --file",
		"typecheck": "tsc --noEmit",
		"prepare": "husky"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.11",
		"@cloudflare/vitest-pool-workers": "^0.22.0",
		"@cloudflare/workers-types": "^5.20260829.1",
		"@types/bun": "latest",
		"husky": "^9.1.7",
		"lint-staged": "^17.4.1",
		"vitest": "^4.1.11",
		"wrangler": "^4.127.1"
	},
	"lint-staged": {
		"*.{js,ts,jsx,tsx,json}": [
			"bunx @biomejs/biome check --write --no-errors-on-unmatched"
		]
	},
	"peerDependencies": {
		"typescript": "^5"
	}
}
